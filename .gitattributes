# Auto detect text files and perform LF normalization (GitHub Recommended)
* text=auto eol=lf

# Explicitly declare text files to always use LF in the repository
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.gs text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Denote all binary files to prevent line-ending modifications
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.xlsx binary
*.xls binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.wav binary
*.ogg binary

